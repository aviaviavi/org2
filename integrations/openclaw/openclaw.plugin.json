{
  "id": "org2-lifecycle",
  "name": "Org2 Lifecycle",
  "description": "Synchronizes substantial OpenClaw executions into Org2 Run Center.",
  "activation": { "onStartup": true },
  "contracts": {
    "tools": ["org2_gmail_draft_send"]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "corpusDir": { "type": "string" },
      "stateFile": { "type": "string" },
      "gogExecutable": { "type": "string" },
      "owner": { "type": "string" },
      "trackMainTurns": { "type": "boolean" },
      "trackCron": { "type": "boolean" },
      "trackSubagents": { "type": "boolean" }
    }
  }
}
