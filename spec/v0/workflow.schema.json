{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://org2.avi.press/spec/v0/workflow.schema.json",
  "title": "Org2 reusable workflow",
  "type": "object",
  "required": ["schema", "id", "version", "title", "instructions", "capabilities", "riskClass", "inputs", "steps", "outputs", "validations", "approvals", "triggers", "compatibility", "createdAt", "updatedAt"],
  "properties": {
    "schema": { "const": "org2:workflow:v1" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "version": { "type": "string" },
    "title": { "type": "string", "minLength": 1 },
    "state": { "enum": ["draft", "active", "paused"] },
    "instructions": { "type": "string", "minLength": 1 },
    "capabilities": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "riskClass": { "enum": ["read-only", "local-draft", "canonical-write", "external-action", "high-impact"] },
    "inputs": { "type": "array" },
    "steps": { "type": "array" },
    "outputs": { "type": "array" },
    "validations": { "type": "array", "items": { "type": "string" } },
    "approvals": { "type": "array", "items": { "$ref": "#/$defs/approvalRequirement" } },
    "triggers": { "type": "array" },
    "compatibility": { "type": "object", "required": ["org2", "schema"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "approvalRequirement": {
      "type": "object",
      "required": ["title", "action", "riskClass"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "title": { "type": "string", "minLength": 1 },
        "action": { "type": "string", "minLength": 1 },
        "riskClass": { "enum": ["read-only", "local-draft", "canonical-write", "external-action", "high-impact"] },
        "requestedRole": { "type": "string" },
        "beforeStepId": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
