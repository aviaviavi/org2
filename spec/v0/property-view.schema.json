{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "org2:property-view:v1",
  "title": "Org2 saved property view",
  "type": "object",
  "required": ["schema", "id", "title", "layout", "scope", "columns", "match", "filters", "sort", "limit"],
  "properties": {
    "schema": { "const": "org2:property-view:v1" },
    "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,99}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[^\\r\\n\\u0000]+$" },
    "layout": { "enum": ["table", "cards"] },
    "scope": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["file", "heading", "all"] },
        "filePrefix": { "type": "string", "description": "Optional portable corpus-relative prefix; absolute, parent and hidden components are rejected by the runtime." }
      }
    },
    "columns": { "type": "array", "minItems": 1, "maxItems": 24, "items": { "$ref": "#/$defs/field" } },
    "match": { "enum": ["all", "any"] },
    "filters": {
      "type": "array", "maxItems": 30,
      "items": {
        "type": "object", "required": ["field", "operator"],
        "properties": {
          "field": { "$ref": "#/$defs/field" },
          "operator": { "enum": ["is", "isNot", "contains", "exists", "missing", "gt", "lt", "active", "terminal"] },
          "value": { "type": "string", "maxLength": 4096, "pattern": "^[^\\r\\n\\u0000]*$", "description": "gt/lt require a finite numeric value; active/terminal apply to the todo field." }
        }
      }
    },
    "sort": {
      "type": "array", "maxItems": 8,
      "items": {
        "type": "object", "required": ["field", "direction"],
        "properties": { "field": { "$ref": "#/$defs/field" }, "direction": { "enum": ["asc", "desc"] } }
      }
    },
    "groupBy": { "$ref": "#/$defs/field" },
    "limit": { "type": "integer", "minimum": 1, "maximum": 5000 }
  },
  "$defs": { "field": { "type": "string", "pattern": "^[A-Za-z0-9_@#%+.-]+$", "description": "Lowercase title/document/file/kind/todo/tags/id are built-in fields; other keys normalize to uppercase property names." } }
}
