{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avi.press/org2/spec/v0/ai-job-manifest.schema.json",
  "title": "Org2 AI job manifest v1",
  "description": "Provider-agnostic manifest for repeatable, inspectable Org2 AI processing jobs. Secrets and provider-specific credentials are intentionally excluded.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "input", "task", "adapter", "output", "provenance", "review"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "org2-ai-job/v1" },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "description": { "type": "string", "minLength": 1 },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "files": { "$ref": "#/$defs/nonEmptyStringArray" },
        "headings": { "$ref": "#/$defs/nonEmptyStringArray" },
        "tags": { "$ref": "#/$defs/nonEmptyStringArray" },
        "dateRange": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "from": { "$ref": "#/$defs/date" },
            "to": { "$ref": "#/$defs/date" }
          }
        },
        "rawZones": { "$ref": "#/$defs/nonEmptyStringArray" },
        "query": { "type": "string", "minLength": 1 },
        "recursive": { "type": "boolean" }
      },
      "anyOf": [
        { "required": ["files"] },
        { "required": ["headings"] },
        { "required": ["tags"] },
        { "required": ["dateRange"] },
        { "required": ["rawZones"] },
        { "required": ["query"] }
      ]
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["summarize", "summarize-meeting", "extract-entities", "suggest-links", "generate-todos", "classify", "digest", "answer"]
        },
        "template": { "type": "string", "minLength": 1 },
        "instructions": { "type": "string", "minLength": 1 },
        "outputSchema": {}
      },
      "anyOf": [
        { "required": ["template"] },
        { "required": ["instructions"] }
      ]
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "description": "Symbolic adapter name resolved from user config, never an API key or secret-bearing URL.",
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "model": {
          "description": "Optional non-secret model/profile label for audit logs.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target"],
      "properties": {
        "target": { "type": "string", "enum": ["stdout", "compiled", "views", "draft-note", "patch-file"] },
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Relative workspace path when target is not stdout. Generated outputs should live in views/ or compiled/ unless explicitly reviewed."
        }
      },
      "allOf": [
        {
          "if": { "properties": { "target": { "not": { "const": "stdout" } } }, "required": ["target"] },
          "then": { "required": ["path"] }
        }
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requireSourceRefs", "promptTemplateVersion", "recordModelMetadata", "recordGeneratedAt"],
      "properties": {
        "requireSourceRefs": { "type": "boolean" },
        "promptTemplateVersion": { "type": "string", "minLength": 1 },
        "recordModelMetadata": { "type": "boolean" },
        "recordGeneratedAt": { "type": "boolean" }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy"],
      "properties": {
        "policy": { "type": "string", "enum": ["require-approval", "auto-write-draft", "stdout-only"] },
        "reviewer": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
