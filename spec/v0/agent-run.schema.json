{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://org2.avi.press/spec/v0/agent-run.schema.json",
  "title": "Org2 Agent Run",
  "type": "object",
  "required": [
    "schema",
    "id",
    "goal",
    "acceptanceCriteria",
    "status",
    "riskClass",
    "capabilities",
    "context",
    "plan",
    "artifacts",
    "approvals",
    "validations",
    "comments",
    "events",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schema": { "const": "org2:agent-run:v1" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "goal": { "type": "string", "minLength": 1 },
    "acceptanceCriteria": { "type": "array", "items": { "type": "string" } },
    "status": { "enum": ["queued", "running", "waiting-approval", "blocked", "completed", "failed", "canceled"] },
    "riskClass": { "enum": ["read-only", "local-draft", "canonical-write", "external-action", "high-impact"] },
    "owner": { "type": "string" },
    "assignee": { "type": "string" },
    "workflowId": { "type": "string" },
    "workflowVersion": { "type": "string" },
    "providerPolicy": { "type": "string" },
    "provider": { "type": "string" },
    "model": { "type": "string" },
    "capabilities": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "context": { "type": "array", "items": { "$ref": "#/$defs/context" } },
    "plan": { "type": "array", "items": { "$ref": "#/$defs/step" } },
    "artifacts": { "type": "array", "items": { "$ref": "#/$defs/artifact" } },
    "approvalRequirements": { "type": "array", "items": { "$ref": "#/$defs/approvalRequirement" } },
    "approvals": { "type": "array", "items": { "$ref": "#/$defs/approval" } },
    "validations": { "type": "array", "items": { "$ref": "#/$defs/validation" } },
    "comments": { "type": "array", "items": { "$ref": "#/$defs/comment" } },
    "events": { "type": "array", "items": { "$ref": "#/$defs/event" } },
    "budget": {
      "type": "object",
      "properties": {
        "tokenLimit": { "type": "number", "minimum": 0 },
        "costLimitUsd": { "type": "number", "minimum": 0 },
        "timeLimitSeconds": { "type": "number", "minimum": 0 },
        "tokensUsed": { "type": "number", "minimum": 0 },
        "costUsedUsd": { "type": "number", "minimum": 0 },
        "elapsedSeconds": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "parentRunId": { "type": "string" },
    "forkedFromEventId": { "type": "string" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "blockedReason": { "type": "string" },
    "failure": { "type": "string" }
  },
  "$defs": {
    "context": {
      "type": "object",
      "required": ["ref"],
      "properties": {
        "ref": { "type": "string" },
        "title": { "type": "string" },
        "citation": { "type": "string" },
        "sha256": { "type": "string" }
      },
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "required": ["id", "title", "kind", "status"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "kind": { "enum": ["compiler", "agent", "tool", "approval", "artifact", "validation"] },
        "status": { "enum": ["pending", "running", "completed", "blocked", "failed", "skipped"] },
        "capability": { "type": "string" },
        "startedAt": { "type": "string" },
        "completedAt": { "type": "string" },
        "detail": { "type": "string" }
      },
      "additionalProperties": false
    },
    "artifact": { "type": "object", "required": ["id", "path", "role", "createdAt"] },
    "approvalRequirement": {
      "type": "object",
      "required": ["id", "title", "action", "riskClass"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "title": { "type": "string", "minLength": 1 },
        "action": { "type": "string", "minLength": 1 },
        "riskClass": { "enum": ["read-only", "local-draft", "canonical-write", "external-action", "high-impact"] },
        "requestedRole": { "type": "string" },
        "beforeStepId": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "approval": {
      "type": "object",
      "required": ["id", "title", "action", "riskClass", "status", "requestedAt"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "action": { "type": "string", "minLength": 1 },
        "riskClass": { "enum": ["read-only", "local-draft", "canonical-write", "external-action", "high-impact"] },
        "status": { "enum": ["pending", "approved", "rejected", "revised", "canceled"] },
        "requirementId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "material": { "$ref": "#/$defs/approvalMaterial" },
        "supersedesId": { "type": "string", "minLength": 1 },
        "requestedRole": { "type": "string" },
        "requestedFrom": { "type": "string" },
        "requestedAt": { "type": "string", "format": "date-time" },
        "decidedAt": { "type": "string", "format": "date-time" },
        "decidedBy": { "type": "string" },
        "note": { "type": "string" },
        "decisionNote": { "type": "string" },
        "receipt": { "type": "string" },
        "effectReservation": {
          "type": "object",
          "required": ["fingerprint", "materialDigest", "toolCallId", "reservedAt"],
          "properties": {
            "fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
            "materialDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
            "toolCallId": { "type": "string", "minLength": 1 },
            "reservedAt": { "type": "string", "format": "date-time" }
          },
          "additionalProperties": false
        },
        "effectReceipt": {
          "type": "object",
          "required": ["fingerprint", "performedAt"],
          "properties": {
            "fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
            "performedAt": { "type": "string", "format": "date-time" },
            "system": { "type": "string" },
            "externalId": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "approvalMaterial": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["message", "command", "artifact-release", "external-action"] },
        "target": { "type": "string" },
        "content": { "type": "string" },
        "command": {
          "type": "object",
          "required": ["text"],
          "properties": {
            "text": { "type": "string" },
            "argv": { "type": "array", "items": { "type": "string" } },
            "cwd": { "type": "string" }
          },
          "additionalProperties": false
        },
        "attachments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "sha256"],
            "properties": {
              "name": { "type": "string" },
              "path": { "type": "string" },
              "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
            },
            "additionalProperties": false
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "sha256"],
            "properties": {
              "id": { "type": "string" },
              "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
            },
            "additionalProperties": false
          }
        },
        "runtimeTarget": {
          "type": "object",
          "required": ["system", "kind", "id"],
          "properties": {
            "system": { "type": "string" },
            "kind": { "type": "string" },
            "id": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "validation": { "type": "object", "required": ["id", "name", "status", "checkedAt"] },
    "comment": { "type": "object", "required": ["id", "author", "body", "createdAt"] },
    "event": { "type": "object", "required": ["id", "type", "at"] }
  },
  "additionalProperties": false
}
