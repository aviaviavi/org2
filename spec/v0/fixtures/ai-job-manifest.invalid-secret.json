{
  "schemaVersion": "org2-ai-job/v1",
  "id": "bad-secret-job",
  "input": { "files": ["notes/*.org"] },
  "task": { "type": "summarize", "instructions": "Summarize selected notes." },
  "adapter": {
    "name": "work-summary",
    "apiKey": "sk-this-secret-does-not-belong-in-a-manifest"
  },
  "output": { "target": "views", "path": "views/bad.org2" },
  "provenance": {
    "requireSourceRefs": true,
    "promptTemplateVersion": "summary@v1",
    "recordModelMetadata": true,
    "recordGeneratedAt": true
  },
  "review": { "policy": "require-approval" }
}
