{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avi.press/org2/spec/v0/canonical-ast.schema.json",
  "title": "Org2 Canonical AST (v0)",
  "type": "object",
  "additionalProperties": false,

  "required": ["type", "version", "children"],
  "properties": {
    "type": {
      "const": "Document"
    },
    "version": {
      "type": "string",
      "const": "0"
    },
    "children": {
      "type": "array",
      "items": { "$ref": "#/$defs/Node" }
    }
  },
  "$defs": {
    "Node": {
      "oneOf": [
        { "$ref": "#/$defs/Headline" },
        { "$ref": "#/$defs/Paragraph" },
        { "$ref": "#/$defs/List" },
        { "$ref": "#/$defs/ListItem" },
        { "$ref": "#/$defs/KeywordLine" },
        { "$ref": "#/$defs/DirectiveLine" },
        { "$ref": "#/$defs/CommentLine" },
        { "$ref": "#/$defs/Planning" },
        { "$ref": "#/$defs/PropertyDrawer" },
        { "$ref": "#/$defs/Drawer" },
        { "$ref": "#/$defs/SrcBlock" },
        { "$ref": "#/$defs/Block" },
        { "$ref": "#/$defs/Table" },
        { "$ref": "#/$defs/Text" }
      ]
    },
    "Headline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "level", "title", "children"],
      "properties": {
        "type": { "const": "Headline" },
        "level": { "type": "integer", "minimum": 1 },
        "todo": { "type": "string" },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "title": {
          "type": "array",
          "items": { "$ref": "#/$defs/Inline" }
        },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/Node" }
        }
      }
    },
    "Paragraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "children"],
      "properties": {
        "type": { "const": "Paragraph" },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/Inline" }
        }
      }
    },
    "List": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "ordered", "items"],
      "properties": {
        "type": { "const": "List" },
        "ordered": { "type": "boolean" },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/ListItem" }
        }
      }
    },
    "ListItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "children"],
      "properties": {
        "type": { "const": "ListItem" },
        "ordinal": {
          "type": "integer",
          "minimum": 0
        },
        "checkbox": {
          "type": "string",
          "enum": ["unchecked", "checked"]
        },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/Node" }
        }
      }
    },
    "KeywordLine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "raw", "indent", "keyRaw", "valueRaw"],
      "properties": {
        "type": { "const": "KeywordLine" },
        "raw": { "type": "string" },
        "indent": { "type": "string" },
        "keyRaw": { "type": "string" },
        "valueRaw": { "type": "string" }
      }
    },
    "DirectiveLine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "raw", "indent", "keywordRaw", "afterKeywordRaw"],
      "properties": {
        "type": { "const": "DirectiveLine" },
        "raw": { "type": "string" },
        "indent": { "type": "string" },
        "keywordRaw": { "type": "string" },
        "afterKeywordRaw": { "type": "string" }
      }
    },
    "CommentLine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "raw", "indent", "bodyRaw"],
      "properties": {
        "type": { "const": "CommentLine" },
        "raw": { "type": "string" },
        "indent": { "type": "string" },
        "bodyRaw": { "type": "string" }
      }
    },
    "Planning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "kind", "raw"],
      "properties": {
        "type": { "const": "Planning" },
        "kind": { "type": "string", "enum": ["SCHEDULED", "DEADLINE", "CLOSED"] },
        "raw": { "type": "string" },
        "timestamp": {
          "oneOf": [{ "$ref": "#/$defs/Timestamp" }, { "$ref": "#/$defs/TimestampRange" }]
        }
      }
    },
    "PropertyDrawer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "properties"],
      "properties": {
        "type": { "const": "PropertyDrawer" },
        "properties": {
          "type": "array",
          "items": { "$ref": "#/$defs/Property" }
        }
      }
    },
    "Property": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "value"],
      "properties": {
        "key": { "type": "string" },
        "value": { "type": "string" }
      }
    },
    "Drawer": {
      "oneOf": [{ "$ref": "#/$defs/DrawerTerminated" }, { "$ref": "#/$defs/DrawerUnterminated" }]
    },
    "DrawerTerminated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "nameRaw", "indent", "terminated", "bodyRaw", "endRaw"],
      "properties": {
        "type": { "const": "Drawer" },
        "nameRaw": { "type": "string" },
        "indent": { "type": "string" },
        "terminated": { "const": true },
        "bodyRaw": { "type": "string" },
        "endRaw": { "type": "string" }
      }
    },
    "DrawerUnterminated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "nameRaw", "indent", "terminated", "bodyRaw"],
      "properties": {
        "type": { "const": "Drawer" },
        "nameRaw": { "type": "string" },
        "indent": { "type": "string" },
        "terminated": { "const": false },
        "bodyRaw": { "type": "string" }
      }
    },
    "SrcBlock": {
      "oneOf": [{ "$ref": "#/$defs/SrcBlockTerminated" }, { "$ref": "#/$defs/SrcBlockUnterminated" }]
    },
    "SrcBlockLine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["indent", "keywordRaw", "afterKeywordRaw"],
      "properties": {
        "indent": { "type": "string" },
        "keywordRaw": { "type": "string" },
        "afterKeywordRaw": { "type": "string" }
      }
    },
    "SrcBlockTerminated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "terminated", "begin", "bodyRaw", "end"],
      "properties": {
        "type": { "const": "SrcBlock" },
        "affiliatedKeywords": {
          "type": "array",
          "items": { "$ref": "#/$defs/KeywordLine" }
        },
        "terminated": { "const": true },
        "begin": { "$ref": "#/$defs/SrcBlockLine" },
        "bodyRaw": { "type": "string" },
        "end": { "$ref": "#/$defs/SrcBlockLine" }
      }
    },
    "SrcBlockUnterminated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "terminated", "begin", "bodyRaw"],
      "properties": {
        "type": { "const": "SrcBlock" },
        "affiliatedKeywords": {
          "type": "array",
          "items": { "$ref": "#/$defs/KeywordLine" }
        },
        "terminated": { "const": false },
        "begin": { "$ref": "#/$defs/SrcBlockLine" },
        "bodyRaw": { "type": "string" }
      }
    },
    "Block": {
      "oneOf": [{ "$ref": "#/$defs/BlockTerminated" }, { "$ref": "#/$defs/BlockUnterminated" }]
    },
    "BlockTerminated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "kind", "terminated", "begin", "bodyRaw", "end"],
      "properties": {
        "type": { "const": "Block" },
        "affiliatedKeywords": {
          "type": "array",
          "items": { "$ref": "#/$defs/KeywordLine" }
        },
        "kind": { "type": "string", "enum": ["example", "quote", "verse", "center", "comment", "export"] },
        "terminated": { "const": true },
        "begin": { "$ref": "#/$defs/SrcBlockLine" },
        "bodyRaw": { "type": "string" },
        "end": { "$ref": "#/$defs/SrcBlockLine" }
      }
    },
    "BlockUnterminated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "kind", "terminated", "begin", "bodyRaw"],
      "properties": {
        "type": { "const": "Block" },
        "affiliatedKeywords": {
          "type": "array",
          "items": { "$ref": "#/$defs/KeywordLine" }
        },
        "kind": { "type": "string", "enum": ["example", "quote", "verse", "center", "comment", "export"] },
        "terminated": { "const": false },
        "begin": { "$ref": "#/$defs/SrcBlockLine" },
        "bodyRaw": { "type": "string" }
      }
    },
    "Table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "rows"],
      "properties": {
        "type": { "const": "Table" },
        "affiliatedKeywords": {
          "type": "array",
          "items": { "$ref": "#/$defs/KeywordLine" }
        },
        "rows": {
          "type": "array",
          "items": { "$ref": "#/$defs/TableRow" }
        }
      }
    },
    "TableRow": {
      "oneOf": [{ "$ref": "#/$defs/TableDataRow" }, { "$ref": "#/$defs/TableHline" }]
    },
    "TableDataRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "indent", "cells"],
      "properties": {
        "type": { "const": "TableRow" },
        "indent": { "type": "string" },
        "cells": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "TableHline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "indent", "raw"],
      "properties": {
        "type": { "const": "TableHline" },
        "indent": { "type": "string" },
        "raw": { "type": "string" }
      }
    },
    "Text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": { "const": "Text" },
        "value": { "type": "string" }
      }
    },
    "TimestampRepeater": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "value", "unit", "raw"],
      "properties": {
        "mode": { "type": "string", "enum": ["+", "++", ".+"] },
        "value": { "type": "integer", "minimum": 1 },
        "unit": { "type": "string", "enum": ["d", "w", "m", "y"] },
        "raw": { "type": "string" }
      }
    },
    "TimestampWarning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "value", "unit", "raw"],
      "properties": {
        "mode": { "type": "string", "enum": ["-", "--"] },
        "value": { "type": "integer", "minimum": 1 },
        "unit": { "type": "string", "enum": ["d", "w", "m", "y"] },
        "raw": { "type": "string" }
      }
    },
    "Timestamp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "active", "raw"],
      "properties": {
        "type": { "const": "Timestamp" },
        "active": { "type": "boolean" },
        "raw": { "type": "string" },
        "repeater": { "$ref": "#/$defs/TimestampRepeater" },
        "warning": { "$ref": "#/$defs/TimestampWarning" }
      }
    },
    "TimestampRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "start", "separatorRaw", "end"],
      "properties": {
        "type": { "const": "TimestampRange" },
        "start": { "$ref": "#/$defs/Timestamp" },
        "separatorRaw": { "type": "string" },
        "end": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "Link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "format", "raw", "targetRaw"],
      "properties": {
        "type": { "const": "Link" },
        "format": { "type": "string", "enum": ["bracket", "plain"] },
        "raw": { "type": "string" },
        "targetRaw": { "type": "string" },
        "descriptionRaw": { "type": "string" }
      }
    },
    "Inline": {
      "oneOf": [
        { "$ref": "#/$defs/Text" },
        { "$ref": "#/$defs/Timestamp" },
        { "$ref": "#/$defs/TimestampRange" },
        { "$ref": "#/$defs/Emphasis" },
        { "$ref": "#/$defs/Link" }
      ]
    },
    "Emphasis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "kind", "marker", "content"],
      "properties": {
        "type": { "const": "Emphasis" },
        "kind": {
          "type": "string",
          "enum": ["bold", "italic", "underline", "strike", "verbatim", "code"]
        },
        "marker": { "type": "string" },
        "content": { "type": "string" }
      }
    }
  }
}
