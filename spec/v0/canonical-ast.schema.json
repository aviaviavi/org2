{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avi.press/org2/spec/v0/canonical-ast.schema.json",
  "title": "Org2 Canonical AST (v0)",
  "type": "object",
  "additionalProperties": false,

  "required": ["type", "version", "children"],
  "properties": {
    "type": {
      "const": "Document"
    },
    "version": {
      "type": "string",
      "const": "0"
    },
    "children": {
      "type": "array",
      "items": { "$ref": "#/$defs/Node" }
    }
  },
  "$defs": {
    "Node": {
      "oneOf": [
        { "$ref": "#/$defs/Headline" },
        { "$ref": "#/$defs/Paragraph" },
        { "$ref": "#/$defs/List" },
        { "$ref": "#/$defs/ListItem" },
        { "$ref": "#/$defs/KeywordLine" },
        { "$ref": "#/$defs/DirectiveLine" },
        { "$ref": "#/$defs/CommentLine" },
        { "$ref": "#/$defs/Planning" },
        { "$ref": "#/$defs/Clock" },
        { "$ref": "#/$defs/PropertyDrawer" },
        { "$ref": "#/$defs/Drawer" },
        { "$ref": "#/$defs/SrcBlock" },
        { "$ref": "#/$defs/Block" },
        { "$ref": "#/$defs/DynamicBlock" },
        { "$ref": "#/$defs/FixedWidth" },
        { "$ref": "#/$defs/HorizontalRule" },
        { "$ref": "#/$defs/LatexEnvironment" },
        { "$ref": "#/$defs/DiarySexp" },
        { "$ref": "#/$defs/FootnoteDefinition" },
        { "$ref": "#/$defs/Table" },
        { "$ref": "#/$defs/Text" }
      ]
    },
    "Headline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "level", "title", "children"],
      "properties": {
        "type": { "const": "Headline" },
        "level": { "type": "integer", "minimum": 1 },
        "todo": { "type": "string" },
        "priority": { "type": "string", "pattern": "^[A-Za-z0-9]$" },
        "commented": { "type": "boolean" },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "title": {
          "type": "array",
          "items": { "$ref": "#/$defs/Inline" }
        },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/Node" }
        }
      }
    },
    "Paragraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "children"],
      "properties": {
        "type": { "const": "Paragraph" },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/Inline" }
        }
      }
    },
    "List": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "ordered", "items"],
      "properties": {
        "type": { "const": "List" },
        "ordered": { "type": "boolean" },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/ListItem" }
        }
      }
    },
    "ListItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "children"],
      "properties": {
        "type": { "const": "ListItem" },
        "ordinal": {
          "type": "integer",
          "minimum": 0
        },
        "counter": {
          "type": "integer",
          "minimum": 0
        },
        "checkbox": {
          "type": "string",
          "enum": ["unchecked", "checked", "indeterminate"]
        },
        "descriptionTag": {
          "type": "array",
          "items": { "$ref": "#/$defs/Inline" }
        },
        "progressCookie": {
          "$ref": "#/$defs/ProgressCookie"
        },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/Node" }
        }
      }
    },
    "KeywordLine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "raw", "indent", "keyRaw", "valueRaw"],
      "properties": {
        "type": { "const": "KeywordLine" },
        "raw": { "type": "string" },
        "indent": { "type": "string" },
        "keyRaw": { "type": "string" },
        "valueRaw": { "type": "string" }
      }
    },
    "DirectiveLine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "raw", "indent", "keywordRaw", "afterKeywordRaw"],
      "properties": {
        "type": { "const": "DirectiveLine" },
        "raw": { "type": "string" },
        "indent": { "type": "string" },
        "keywordRaw": { "type": "string" },
        "afterKeywordRaw": { "type": "string" }
      }
    },
    "CommentLine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "raw", "indent", "bodyRaw"],
      "properties": {
        "type": { "const": "CommentLine" },
        "raw": { "type": "string" },
        "indent": { "type": "string" },
        "bodyRaw": { "type": "string" }
      }
    },
    "Planning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "kind", "raw"],
      "properties": {
        "type": { "const": "Planning" },
        "kind": { "type": "string", "enum": ["SCHEDULED", "DEADLINE", "CLOSED"] },
        "raw": { "type": "string" },
        "timestamp": {
          "oneOf": [{ "$ref": "#/$defs/Timestamp" }, { "$ref": "#/$defs/TimestampRange" }]
        }
      }
    },
    "Clock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "raw"],
      "properties": {
        "type": { "const": "Clock" },
        "raw": { "type": "string" },
        "start": { "$ref": "#/$defs/Timestamp" },
        "end": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "PropertyDrawer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "properties"],
      "properties": {
        "type": { "const": "PropertyDrawer" },
        "properties": {
          "type": "array",
          "items": { "$ref": "#/$defs/Property" }
        }
      }
    },
    "Property": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "value"],
      "properties": {
        "key": { "type": "string" },
        "value": { "type": "string" }
      }
    },
    "Drawer": {
      "oneOf": [{ "$ref": "#/$defs/DrawerTerminated" }, { "$ref": "#/$defs/DrawerUnterminated" }]
    },
    "DrawerTerminated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "nameRaw", "indent", "terminated", "bodyRaw", "endRaw"],
      "properties": {
        "type": { "const": "Drawer" },
        "nameRaw": { "type": "string" },
        "indent": { "type": "string" },
        "terminated": { "const": true },
        "bodyRaw": { "type": "string" },
        "endRaw": { "type": "string" }
      }
    },
    "DrawerUnterminated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "nameRaw", "indent", "terminated", "bodyRaw"],
      "properties": {
        "type": { "const": "Drawer" },
        "nameRaw": { "type": "string" },
        "indent": { "type": "string" },
        "terminated": { "const": false },
        "bodyRaw": { "type": "string" }
      }
    },
    "SrcBlock": {
      "oneOf": [{ "$ref": "#/$defs/SrcBlockTerminated" }, { "$ref": "#/$defs/SrcBlockUnterminated" }]
    },
    "SrcBlockLine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["indent", "keywordRaw", "afterKeywordRaw"],
      "properties": {
        "indent": { "type": "string" },
        "keywordRaw": { "type": "string" },
        "afterKeywordRaw": { "type": "string" }
      }
    },
    "SrcBlockTerminated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "terminated", "begin", "bodyRaw", "end"],
      "properties": {
        "type": { "const": "SrcBlock" },
        "affiliatedKeywords": {
          "type": "array",
          "items": { "$ref": "#/$defs/KeywordLine" }
        },
        "terminated": { "const": true },
        "begin": { "$ref": "#/$defs/SrcBlockLine" },
        "bodyRaw": { "type": "string" },
        "end": { "$ref": "#/$defs/SrcBlockLine" }
      }
    },
    "SrcBlockUnterminated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "terminated", "begin", "bodyRaw"],
      "properties": {
        "type": { "const": "SrcBlock" },
        "affiliatedKeywords": {
          "type": "array",
          "items": { "$ref": "#/$defs/KeywordLine" }
        },
        "terminated": { "const": false },
        "begin": { "$ref": "#/$defs/SrcBlockLine" },
        "bodyRaw": { "type": "string" }
      }
    },
    "Block": {
      "oneOf": [{ "$ref": "#/$defs/BlockTerminated" }, { "$ref": "#/$defs/BlockUnterminated" }]
    },
    "BlockTerminated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "kind", "terminated", "begin", "bodyRaw", "end"],
      "properties": {
        "type": { "const": "Block" },
        "affiliatedKeywords": {
          "type": "array",
          "items": { "$ref": "#/$defs/KeywordLine" }
        },
        "kind": { "type": "string" },
        "terminated": { "const": true },
        "begin": { "$ref": "#/$defs/SrcBlockLine" },
        "bodyRaw": { "type": "string" },
        "end": { "$ref": "#/$defs/SrcBlockLine" }
      }
    },
    "BlockUnterminated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "kind", "terminated", "begin", "bodyRaw"],
      "properties": {
        "type": { "const": "Block" },
        "affiliatedKeywords": {
          "type": "array",
          "items": { "$ref": "#/$defs/KeywordLine" }
        },
        "kind": { "type": "string" },
        "terminated": { "const": false },
        "begin": { "$ref": "#/$defs/SrcBlockLine" },
        "bodyRaw": { "type": "string" }
      }
    },
    "DynamicBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "nameRaw", "parametersRaw", "indent", "beginRaw", "bodyRaw", "terminated"],
      "properties": {
        "type": { "const": "DynamicBlock" },
        "affiliatedKeywords": { "type": "array", "items": { "$ref": "#/$defs/KeywordLine" } },
        "nameRaw": { "type": "string" },
        "parametersRaw": { "type": "string" },
        "indent": { "type": "string" },
        "beginRaw": { "type": "string" },
        "bodyRaw": { "type": "string" },
        "terminated": { "type": "boolean" },
        "endRaw": { "type": "string" }
      }
    },
    "FixedWidthLine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw", "indent", "valueRaw"],
      "properties": {
        "raw": { "type": "string" },
        "indent": { "type": "string" },
        "valueRaw": { "type": "string" }
      }
    },
    "FixedWidth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "lines"],
      "properties": {
        "type": { "const": "FixedWidth" },
        "lines": { "type": "array", "items": { "$ref": "#/$defs/FixedWidthLine" } }
      }
    },
    "HorizontalRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "raw", "indent"],
      "properties": {
        "type": { "const": "HorizontalRule" },
        "raw": { "type": "string" },
        "indent": { "type": "string" }
      }
    },
    "LatexEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "nameRaw", "beginRaw", "bodyRaw", "terminated"],
      "properties": {
        "type": { "const": "LatexEnvironment" },
        "nameRaw": { "type": "string" },
        "beginRaw": { "type": "string" },
        "bodyRaw": { "type": "string" },
        "terminated": { "type": "boolean" },
        "endRaw": { "type": "string" }
      }
    },
    "DiarySexp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "raw"],
      "properties": {
        "type": { "const": "DiarySexp" },
        "raw": { "type": "string" }
      }
    },
    "FootnoteDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "labelRaw", "children"],
      "properties": {
        "type": { "const": "FootnoteDefinition" },
        "labelRaw": { "type": "string" },
        "children": { "type": "array", "items": { "$ref": "#/$defs/Inline" } }
      }
    },
    "Table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "rows"],
      "properties": {
        "type": { "const": "Table" },
        "affiliatedKeywords": {
          "type": "array",
          "items": { "$ref": "#/$defs/KeywordLine" }
        },
        "rows": {
          "type": "array",
          "items": { "$ref": "#/$defs/TableRow" }
        }
      }
    },
    "TableRow": {
      "oneOf": [{ "$ref": "#/$defs/TableDataRow" }, { "$ref": "#/$defs/TableHline" }]
    },
    "TableDataRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "indent", "cells"],
      "properties": {
        "type": { "const": "TableRow" },
        "indent": { "type": "string" },
        "cells": {
          "type": "array",
          "items": { "type": "string" }
        },
        "contents": {
          "type": "array",
          "items": { "type": "array", "items": { "$ref": "#/$defs/Inline" } }
        }
      }
    },
    "TableHline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "indent", "raw"],
      "properties": {
        "type": { "const": "TableHline" },
        "indent": { "type": "string" },
        "raw": { "type": "string" }
      }
    },
    "Text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": { "const": "Text" },
        "value": { "type": "string" }
      }
    },
    "TimestampRepeater": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "value", "unit", "raw"],
      "properties": {
        "mode": { "type": "string", "enum": ["+", "++", ".+"] },
        "value": { "type": "integer", "minimum": 1 },
        "unit": { "type": "string", "enum": ["d", "w", "m", "y"] },
        "raw": { "type": "string" }
      }
    },
    "TimestampWarning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "value", "unit", "raw"],
      "properties": {
        "mode": { "type": "string", "enum": ["-", "--"] },
        "value": { "type": "integer", "minimum": 1 },
        "unit": { "type": "string", "enum": ["d", "w", "m", "y"] },
        "raw": { "type": "string" }
      }
    },
    "Timestamp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "active", "raw"],
      "properties": {
        "type": { "const": "Timestamp" },
        "active": { "type": "boolean" },
        "raw": { "type": "string" },
        "repeater": { "$ref": "#/$defs/TimestampRepeater" },
        "warning": { "$ref": "#/$defs/TimestampWarning" }
      }
    },
    "TimestampRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "start", "separatorRaw", "end"],
      "properties": {
        "type": { "const": "TimestampRange" },
        "start": { "$ref": "#/$defs/Timestamp" },
        "separatorRaw": { "type": "string" },
        "end": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "Link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "format", "raw", "targetRaw"],
      "properties": {
        "type": { "const": "Link" },
        "format": { "type": "string", "enum": ["bracket", "plain", "angle"] },
        "raw": { "type": "string" },
        "targetRaw": { "type": "string" },
        "descriptionRaw": { "type": "string" }
      }
    },
    "Inline": {
      "oneOf": [
        { "$ref": "#/$defs/Text" },
        { "$ref": "#/$defs/Timestamp" },
        { "$ref": "#/$defs/TimestampRange" },
        { "$ref": "#/$defs/Emphasis" },
        { "$ref": "#/$defs/Link" },
        { "$ref": "#/$defs/ProgressCookie" },
        { "$ref": "#/$defs/Entity" },
        { "$ref": "#/$defs/LatexFragment" },
        { "$ref": "#/$defs/ExportSnippet" },
        { "$ref": "#/$defs/FootnoteReference" },
        { "$ref": "#/$defs/Citation" },
        { "$ref": "#/$defs/Target" },
        { "$ref": "#/$defs/Script" },
        { "$ref": "#/$defs/LineBreak" }
      ]
    },
    "ProgressCookie": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "raw", "format"],
      "properties": {
        "type": { "const": "ProgressCookie" },
        "raw": { "type": "string" },
        "format": { "type": "string", "enum": ["fraction", "percent"] },
        "done": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 },
        "percent": { "type": "integer", "minimum": 0 }
      }
    },
    "Entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "raw", "nameRaw"],
      "properties": {
        "type": { "const": "Entity" },
        "raw": { "type": "string" },
        "nameRaw": { "type": "string" }
      }
    },
    "LatexFragment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "raw", "display"],
      "properties": {
        "type": { "const": "LatexFragment" },
        "raw": { "type": "string" },
        "display": { "type": "boolean" }
      }
    },
    "ExportSnippet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "raw", "backendRaw", "valueRaw"],
      "properties": {
        "type": { "const": "ExportSnippet" },
        "raw": { "type": "string" },
        "backendRaw": { "type": "string" },
        "valueRaw": { "type": "string" }
      }
    },
    "FootnoteReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "raw"],
      "properties": {
        "type": { "const": "FootnoteReference" },
        "raw": { "type": "string" },
        "labelRaw": { "type": "string" },
        "definitionRaw": { "type": "string" }
      }
    },
    "CitationReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyRaw"],
      "properties": {
        "keyRaw": { "type": "string" },
        "prefixRaw": { "type": "string" },
        "suffixRaw": { "type": "string" }
      }
    },
    "Citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "raw", "references"],
      "properties": {
        "type": { "const": "Citation" },
        "raw": { "type": "string" },
        "styleRaw": { "type": "string" },
        "prefixRaw": { "type": "string" },
        "suffixRaw": { "type": "string" },
        "references": { "type": "array", "items": { "$ref": "#/$defs/CitationReference" } }
      }
    },
    "Target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "raw", "valueRaw", "radio"],
      "properties": {
        "type": { "const": "Target" },
        "raw": { "type": "string" },
        "valueRaw": { "type": "string" },
        "radio": { "type": "boolean" }
      }
    },
    "Script": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "raw", "kind", "valueRaw"],
      "properties": {
        "type": { "const": "Script" },
        "raw": { "type": "string" },
        "kind": { "type": "string", "enum": ["subscript", "superscript"] },
        "valueRaw": { "type": "string" }
      }
    },
    "LineBreak": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "raw"],
      "properties": {
        "type": { "const": "LineBreak" },
        "raw": { "type": "string" }
      }
    },
    "Emphasis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "kind", "marker", "content"],
      "properties": {
        "type": { "const": "Emphasis" },
        "kind": {
          "type": "string",
          "enum": ["bold", "italic", "underline", "strike", "verbatim", "code"]
        },
        "marker": { "type": "string" },
        "content": { "type": "string" }
      }
    }
  }
}
