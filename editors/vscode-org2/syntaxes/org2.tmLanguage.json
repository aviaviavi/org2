    "drawers": {
      "patterns": [
        {
          "name": "meta.drawer.org2",
          "begin": "^(?:\\s*):([A-Za-z0-9_\\-]+):\\s*$",
          "beginCaptures": {
            "0": {
              "name": "keyword.other.drawer.begin.org2"
            },
            "1": {
              "name": "support.constant.drawer.name.org2"
            }
          },
          "end": "^(?:\\s*):END:\\s*$",
          "endCaptures": {
            "0": {
              "name": "keyword.other.drawer.end.org2"
            }
          },
          "patterns": [
            {
              "name": "meta.property.org2",
              "match": "^(?:\\s*):([A-Za-z0-9_\\-]+):\\s*(.*)$",
              "captures": {
                "1": {
                  "name": "variable.other.property.org2"
                },
                "2": {
                  "name": "string.unquoted.org2"
                }
              }
            }
          ]
        }
      ]
