    "propertyLines": {
      "patterns": [
        {
          "name": "meta.property.org2",
          "match": "^(?:\\s*):([A-Za-z0-9_\\-]+):\\s*(.*)$",
          "captures": {
            "1": {
              "name": "variable.other.property.org2"
            },
            "2": {
              "name": "string.unquoted.org2"
            }
          }
        }
      ]
    },
    "tables": {
      "patterns": [
        {
          "name": "meta.table.separator.org2",
          "match": "^(?:\\s*)\\|[-+|]+\\|\\s*$"
        },
        {
          "name": "meta.table.org2",
          "match": "^(?:\\s*)\\|.*\\|\\s*$"
        }
      ]
    },
    "lists": {
      "patterns": [
        {
          "name": "punctuation.definition.list.bullet.org2",
          "match": "^(?:\\s*)([-+*])(?=\\s)",
          "captures": {
            "1": {
              "name": "punctuation.definition.list.org2"
            }
          }
        },
        {
          "name": "constant.numeric.list.org2",
          "match": "^(?:\\s*)\\d+[.)](?=\\s)"
        }
      ]
    },
    "checkboxes": {
      "patterns": [
        {
          "name": "constant.other.checkbox.org2",
          "match": "\\[(?: |X|-)\\]"
        }
      ]
    },
    "timestamps": {
      "patterns": [
        {
          "name": "constant.other.timestamp.org2",
          "match": "<\\d{4}-\\d{2}-\\d{2}[^>]*>"
        },
        {
          "name": "constant.other.timestamp.org2",
          "match": "\\[\\d{4}-\\d{2}-\\d{2}[^\\]]*\\]"
        }
      ]
    },
    "emphasis": {
      "patterns": [
        {
          "name": "markup.bold.org2",
          "match": "(^|[^0-9A-Za-z])\\*[^*\\s][^*]*[^*\\s]\\*"
        },
        {
          "name": "markup.italic.org2",
          "match": "(^|[^0-9A-Za-z])\\/[^\\/\\s][^\\/]*[^\\/\\s]\\/"
        },
        {
          "name": "markup.underline.org2",
          "match": "(^|[^0-9A-Za-z])_[^_\\s][^_]*[^_\\s]_"
        },
        {
          "name": "markup.strikethrough.org2",
          "match": "(^|[^0-9A-Za-z])\\+[^\\+\\s][^\\+]*[^\\+\\s]\\+"
        }
      ]
    },
    "links": {
      "patterns": [
        {
          "name": "markup.underline.link.org2",
          "match": "\\[\\[[^\\]\\n]+?\\](?:\\[[^\\]\\n]*\\])?\\]\\]"
        },
        {
          "name": "markup.underline.link.org2",
          "match": "https?:\\/\\/\\S+"
        }
      ]
    }
  }
