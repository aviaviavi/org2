    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.org2",
          "match": "^(?:\\s*)#(?!\\+).*$"
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "name": "keyword.other.directive.org2",
          "match": "^(?:\\s*)#\\+[A-Za-z0-9_\\-]+(?::\\s+.*)?$"
        }
      ]
    },
    "planning": {
      "patterns": [
        {
          "name": "keyword.other.planning.org2",
          "match": "^(?:\\s*)(?:SCHEDULED|DEADLINE|CLOSED):.*$"
        }
      ]
    },
