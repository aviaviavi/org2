    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.org2",
          "match": "^(?:\\s*)#(?!\\+).*$"
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "name": "meta.directive.html-head.org2",
          "begin": "^(\\s*)(#\\+HTML_HEAD(?:_EXTRA)?:)(\\s*)",
          "beginCaptures": {
            "2": {
              "name": "keyword.control.directive.org2"
            }
          },
          "end": "$",
          "patterns": [
            {
              "include": "text.html.basic"
            }
          ]
        },
        {
          "name": "meta.directive.kv.org2",
          "match": "^(\\s*)(#\\+)(?![Bb][Ee][Gg][Ii][Nn]_)(?![Ee][Nn][Dd]_)([A-Za-z0-9_\\-]+)(:)(\\s*)(.*)$",
          "captures": {
            "2": {
              "name": "punctuation.definition.directive.org2"
            },
            "3": {
              "name": "keyword.control.directive.org2"
            },
            "4": {
              "name": "punctuation.separator.key-value.org2"
            },
            "6": {
              "name": "string.unquoted.directive-value.org2"
            }
          }
        },
        {
          "name": "keyword.other.directive.org2",
          "match": "^(?:\\s*)#\\+[A-Za-z0-9_\\-]+$"
        }
      ]
    },
    "planning": {
      "patterns": [
        {
          "name": "meta.planning.org2",
          "match": "^(\\s*)(SCHEDULED|DEADLINE|CLOSED)(:)(\\s*)(<[^>]+>|\\[[^\\]]+\\])(\\s+)(SCHEDULED|DEADLINE|CLOSED)(:)(\\s*)(<[^>]+>|\\[[^\\]]+\\])\\s*$",
          "captures": {
            "2": {
              "name": "keyword.control.planning.org2"
            },
            "3": {
              "name": "punctuation.separator.key-value.org2"
            },
            "5": {
              "name": "string.other.timestamp.org2"
            },
            "7": {
              "name": "keyword.control.planning.org2"
            },
            "8": {
              "name": "punctuation.separator.key-value.org2"
            },
            "10": {
              "name": "string.other.timestamp.org2"
