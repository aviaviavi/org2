{
  "name": "org2-vscode",
  "displayName": "Org2",
  "description": "Org2 language support (syntax highlighting + folding + agenda)",
  "version": "0.0.1",
  "publisher": "org2",
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:org2",
    "onLanguage:org",
    "onCommand:org2.openAgenda",
    "onCommand:org2.formatWorkspaceCheck",
    "onCommand:org2.formatWorkspaceApply",
    "onCommand:org2.formatCurrentFileCheck",
    "onCommand:org2.formatCurrentFilePreviewDiff",
    "onCommand:org2.formatCurrentFileApply",
    "onCommand:org2.exportCurrentFileHtml",
    "onCommand:org2.exportWorkspaceHtml",
    "onCommand:org2.captureQuickEntry",
    "onCommand:org2.toggleTodo",
    "onCommand:org2.setTodoStatus",
    "onCommand:org2.setTodoTODO",
    "onCommand:org2.setTodoInProgress",
    "onCommand:org2.setTodoDone",
    "onCommand:org2.setTodoCanceled",
    "onCommand:org2.setScheduled",
    "onCommand:org2.setScheduledToday",
    "onCommand:org2.setDeadline",
    "onCommand:org2.setDeadlineToday",
    "onCommand:org2.archiveSubtree",
    "onCommand:org2.refileSubtree",
    "onCommand:org2.roamDailiesGotoToday",
    "onCommand:org2.roamDailiesGotoYesterday",
    "onCommand:org2.roamDailiesGotoTomorrow",
    "onCommand:org2.roamDailiesGotoDate",
    "onCommand:org2.roamNodeNew",
    "onCommand:org2.roamCopyIdLink",
    "onCommand:org2.roamCopyIdLinkById",
    "onCommand:org2.roamInsertBacklink",
    "onCommand:org2.roamOpenId",
    "onCommand:org2.roamShowBacklinks",
    "onCommand:org2.roamShowBacklinksById",
    "onCommand:org2.roamOpenBacklink",
    "onCommand:org2.roamOpenBacklinkById",
    "onCommand:org2.roamDbSync",
    "onCommand:org2.rerunAutoFold"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/aviaviavi/org2"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "org2",
        "aliases": [
          "Org2",
          "org2"
        ],
        "extensions": [
          ".org",
          ".org2"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "org2",
        "scopeName": "source.org2",
        "path": "./syntaxes/org2.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[org2]": {
        "editor.foldingStrategy": "auto"
      }
    },
    "commands": [
      {
        "command": "org2.openAgenda",
        "title": "Org2: Open Agenda"
      },
      {
        "command": "org2.refreshAgenda",
        "title": "Org2: Refresh Agenda"
      },
      {
        "command": "org2.formatWorkspaceCheck",
        "title": "Org2: Formatter — Check Workspace Drift"
      },
      {
        "command": "org2.formatWorkspaceApply",
        "title": "Org2: Formatter — Apply Workspace Formatting"
      },
      {
        "command": "org2.formatCurrentFileCheck",
        "title": "Org2: Formatter — Check Current File Drift"
      },
      {
        "command": "org2.formatCurrentFilePreviewDiff",
        "title": "Org2: Formatter — Preview Current File Diff"
      },
      {
        "command": "org2.formatCurrentFileApply",
        "title": "Org2: Formatter — Apply Current File Formatting"
      },
      {
        "command": "org2.exportCurrentFileHtml",
        "title": "Org2: Export Current File to HTML"
      },
      {
        "command": "org2.exportWorkspaceHtml",
        "title": "Org2: Export Workspace Org Files to HTML"
      },
      {
        "command": "org2.captureQuickEntry",
        "title": "Org2: Capture Quick Entry"
      },
      {
        "command": "org2.pickAgendaFilter",
        "title": "Org2: Agenda Filter"
      },
      {
        "command": "org2.openAgendaItem",
        "title": "Org2: Open Agenda Item"
      },
      {
        "command": "org2.toggleTodo",
        "title": "Org2: Toggle Todo Status"
      },
      {
        "command": "org2.setTodoStatus",
        "title": "Org2: Set Todo Status"
      },
      {
        "command": "org2.setTodoTODO",
        "title": "Org2: Set Todo → TODO"
      },
      {
        "command": "org2.setTodoInProgress",
        "title": "Org2: Set Todo → IN_PROGRESS"
      },
      {
        "command": "org2.setTodoDone",
        "title": "Org2: Set Todo → DONE"
      },
      {
        "command": "org2.setTodoCanceled",
        "title": "Org2: Set Todo → CANCELED"
      },
      {
        "command": "org2.setScheduled",
        "title": "Org2: Set SCHEDULED"
      },
      {
        "command": "org2.setScheduledToday",
        "title": "Org2: Set SCHEDULED to Today"
      },
      {
        "command": "org2.setDeadline",
        "title": "Org2: Set DEADLINE"
      },
      {
        "command": "org2.setDeadlineToday",
        "title": "Org2: Set DEADLINE to Today"
      },
      {
        "command": "org2.archiveSubtree",
        "title": "Org2: Archive Subtree"
      },
      {
        "command": "org2.refileSubtree",
        "title": "Org2: Refile Subtree"
      },
      {
        "command": "org2.roamDailiesGotoToday",
        "title": "Org2: Roam Dailies \u2014 Go to Today"
      },
      {
        "command": "org2.roamDailiesGotoYesterday",
        "title": "Org2: Roam Dailies \u2014 Go to Yesterday"
      },
      {
        "command": "org2.roamDailiesGotoTomorrow",
        "title": "Org2: Roam Dailies \u2014 Go to Tomorrow"
      },
      {
        "command": "org2.roamDailiesGotoDate",
        "title": "Org2: Roam Dailies \u2014 Go to Date"
      },
      {
        "command": "org2.roamNodeNew",
        "title": "Org2: Roam \u2014 New Node"
      },
      {
        "command": "org2.roamCopyIdLink",
        "title": "Org2: Roam \u2014 Copy ID Link (Current Heading/File)"
      },
      {
        "command": "org2.roamCopyIdLinkById",
        "title": "Org2: Roam \u2014 Copy ID Link (Prompt/Link)"
      },
      {
        "command": "org2.roamInsertBacklink",
        "title": "Org2: Roam \u2014 Insert Backlink (Prompt/Link)"
      },
      {
        "command": "org2.roamOpenId",
        "title": "Org2: Roam \u2014 Open ID (Prompt/Link)"
      },
      {
        "command": "org2.roamShowBacklinks",
        "title": "Org2: Roam \u2014 Show Backlinks (Current Heading/File)"
      },
      {
        "command": "org2.roamShowBacklinksById",
        "title": "Org2: Roam \u2014 Show Backlinks (Prompt/Link)"
      },
      {
        "command": "org2.roamOpenBacklink",
        "title": "Org2: Roam \u2014 Open Backlink Source (Current Heading/File)"
      },
      {
        "command": "org2.roamOpenBacklinkById",
        "title": "Org2: Roam \u2014 Open Backlink Source (Prompt/Link)"
      },
      {
        "command": "org2.roamDbSync",
        "title": "Org2: Roam \u2014 DB Sync (Ensure File IDs)"
      },
      {
        "command": "org2.rerunAutoFold",
        "title": "Org2: Re-run Auto-Fold"
      },
      {
        "command": "org2.toggleFoldHere",
        "title": "Org2: Toggle Fold Here"
      },
      {
        "command": "org2.debugFoldingRanges",
        "title": "Org2: Debug Folding Ranges"
      },
      {
        "command": "org2.debugListLinks",
        "title": "Org2: Debug List Links"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "org2Agenda",
          "name": "Org2 Agenda"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "org2.refreshAgenda",
          "when": "view == org2Agenda",
          "group": "navigation"
        },
        {
          "command": "org2.pickAgendaFilter",
          "when": "view == org2Agenda",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "org2.setTodoTODO",
          "when": "view == org2Agenda && viewItem == org2AgendaItem",
          "group": "navigation@10"
        },
        {
          "command": "org2.setTodoInProgress",
          "when": "view == org2Agenda && viewItem == org2AgendaItem",
          "group": "navigation@11"
        },
        {
          "command": "org2.setTodoDone",
          "when": "view == org2Agenda && viewItem == org2AgendaItem",
          "group": "navigation@12"
        },
        {
          "command": "org2.setTodoCanceled",
          "when": "view == org2Agenda && viewItem == org2AgendaItem",
          "group": "navigation@13"
        },
        {
          "command": "org2.toggleTodo",
          "when": "view == org2Agenda && viewItem == org2AgendaItem",
          "group": "navigation@14"
        },
        {
          "command": "org2.setScheduled",
          "when": "view == org2Agenda && viewItem == org2AgendaItem",
          "group": "navigation@15"
        },
        {
          "command": "org2.setScheduledToday",
          "when": "view == org2Agenda && viewItem == org2AgendaItem",
          "group": "navigation@16"
        },
        {
          "command": "org2.setDeadline",
          "when": "view == org2Agenda && viewItem == org2AgendaItem",
          "group": "navigation@17"
        },
        {
          "command": "org2.setDeadlineToday",
          "when": "view == org2Agenda && viewItem == org2AgendaItem",
          "group": "navigation@18"
        },
        {
          "command": "org2.archiveSubtree",
          "when": "view == org2Agenda && viewItem == org2AgendaItem",
          "group": "navigation@19"
        },
        {
          "command": "org2.refileSubtree",
          "when": "view == org2Agenda && viewItem == org2AgendaItem",
          "group": "navigation@20"
        }
      ],
      "editor/context": [
        {
          "command": "org2.toggleTodo",
          "when": "editorTextFocus && (editorLangId == 'org2' || editorLangId == 'org')",
          "group": "navigation@10"
        },
        {
          "command": "org2.setTodoStatus",
          "when": "editorTextFocus && (editorLangId == 'org2' || editorLangId == 'org')",
          "group": "navigation@11"
        },
        {
          "command": "org2.setScheduled",
          "when": "editorTextFocus && (editorLangId == 'org2' || editorLangId == 'org')",
          "group": "navigation@12"
        },
        {
          "command": "org2.setDeadline",
          "when": "editorTextFocus && (editorLangId == 'org2' || editorLangId == 'org')",
          "group": "navigation@13"
        },
        {
          "command": "org2.archiveSubtree",
          "when": "editorTextFocus && (editorLangId == 'org2' || editorLangId == 'org')",
          "group": "navigation@14"
        },
        {
          "command": "org2.refileSubtree",
          "when": "editorTextFocus && (editorLangId == 'org2' || editorLangId == 'org')",
          "group": "navigation@15"
        },
        {
          "command": "org2.captureQuickEntry",
          "when": "editorTextFocus && (editorLangId == 'org2' || editorLangId == 'org')",
          "group": "navigation@15.4"
        },
        {
          "command": "org2.exportCurrentFileHtml",
          "when": "editorTextFocus && (editorLangId == 'org2' || editorLangId == 'org')",
          "group": "navigation@15.5"
        },
        {
          "command": "org2.exportWorkspaceHtml",
          "when": "editorTextFocus && (editorLangId == 'org2' || editorLangId == 'org')",
          "group": "navigation@15.6"
        },
        {
          "command": "org2.roamShowBacklinks",
          "when": "editorTextFocus && (editorLangId == 'org2' || editorLangId == 'org')",
          "group": "navigation@15"
        },
        {
          "command": "org2.roamShowBacklinksById",
          "when": "editorTextFocus && (editorLangId == 'org2' || editorLangId == 'org')",
          "group": "navigation@16"
        },
        {
          "command": "org2.roamCopyIdLinkById",
          "when": "editorTextFocus && (editorLangId == 'org2' || editorLangId == 'org')",
          "group": "navigation@17"
        },
        {
          "command": "org2.roamOpenBacklink",
          "when": "editorTextFocus && (editorLangId == 'org2' || editorLangId == 'org')",
          "group": "navigation@17"
        },
        {
          "command": "org2.roamOpenBacklinkById",
          "when": "editorTextFocus && (editorLangId == 'org2' || editorLangId == 'org')",
          "group": "navigation@18"
        },
        {
          "command": "org2.roamNodeNew",
          "when": "editorTextFocus && (editorLangId == 'org2' || editorLangId == 'org')",
          "group": "navigation@19"
        }
      ]
    },
    "configuration": {
      "title": "Org2",
      "properties": {
        "org2.agenda.command": {
          "type": "string",
          "default": "org2",
          "description": "Command used to run org2 (e.g., 'org2' if installed on PATH, or 'node' with org2.agenda.args)."
        },
        "org2.agenda.args": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Extra args prefixed when calling org2 (advanced; useful for 'node /path/to/dist/cli.js')."
        },
        "org2.agenda.scope": {
          "type": "string",
          "enum": [
            "workspace",
            "files"
          ],
          "default": "workspace",
          "description": "Where to read org files from. 'workspace' scans org2.agenda.dir (or the workspace folder if unset); 'files' uses org2.agenda.files."
        },
        "org2.agenda.dir": {
          "type": "string",
          "default": "",
          "description": "Root directory to scan when scope='workspace'. If empty, uses the VS Code workspace folder. Useful when your org files live outside the workspace."
        },
        "org2.agenda.recursive": {
          "type": "boolean",
          "default": true,
          "description": "When scope='workspace', recursively scan org2.agenda.dir for .org/.org2 files. If false, scans only the top-level directory."
        },
        "org2.roam.dailiesDir": {
          "type": "string",
          "default": "",
          "description": "Root directory for Org2 Roam dailies files (YYYY-MM-DD.org2). If empty, falls back to org2.roam.indexDir, then org2.agenda.dir, then the VS Code workspace folder."
        },
        "org2.roam.indexDir": {
          "type": "string",
          "default": "",
          "description": "Root directory for Org2 Roam ID/query/backlinks/db-sync operations. Absolute paths are used directly; relative paths are resolved against org2.agenda.dir (or workspace root). If empty, uses org2.agenda.dir/workspace root."
        },
        "org2.roam.nodesDir": {
          "type": "string",
          "default": "",
          "description": "Directory for Org2 Roam node creation (`org2 roam node new`). Absolute paths are used directly; relative paths are resolved against org2.roam.indexDir (or org2.agenda.dir/workspace root). If empty, uses org2.roam.indexDir or org2.agenda.dir/workspace root."
        },
        "org2.agenda.files": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "List of org/org2 files (absolute or workspace-relative) to include when scope='files'."
        },
        "org2.agenda.days": {
          "type": "number",
          "default": 7,
          "minimum": 1,
          "maximum": 365,
          "description": "Default agenda window (in days) for the 'Next N days' filter."
        },
        "org2.agenda.startDate": {
          "type": "string",
          "default": "",
          "description": "Optional agenda start date override (YYYY-MM-DD). When set, this replaces the CLI --today anchor for agenda range calculations."
        },
        "org2.agenda.endDate": {
          "type": "string",
          "default": "",
          "description": "Optional agenda end date override (YYYY-MM-DD). When set, this replaces the default days-based end date for agenda range calculations."
        },
        "org2.agenda.limit": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 5000,
          "description": "Maximum number of agenda rows to render after sorting (0 = no limit)."
        },
        "org2.agenda.includeOverdue": {
          "type": "boolean",
          "default": true,
          "description": "Include overdue items in the agenda view."
        },
        "org2.agenda.statusFilter": {
          "type": "string",
          "enum": [
            "all",
            "active",
            "actionable",
            "open",
            "todo",
            "in_progress",
            "done",
            "canceled",
            "closed",
            "custom"
          ],
          "default": "all",
          "description": "Filter agenda rows by TODO state bucket before rendering. all=everything, active=todo+in_progress, actionable=active+custom, closed=done+canceled."
        },
        "org2.agenda.excludeStatusFilter": {
          "type": "string",
          "enum": [
            "all",
            "active",
            "actionable",
            "open",
            "todo",
            "in_progress",
            "done",
            "canceled",
            "closed",
            "custom"
          ],
          "default": "all",
          "description": "Exclude agenda rows by TODO state bucket before rendering. all=no exclusion, active hides todo+in_progress, closed hides done+canceled."
        },
        "org2.agenda.kindFilter": {
          "type": "string",
          "enum": [
            "all",
            "scheduled",
            "deadline"
          ],
          "default": "all",
          "description": "Filter agenda rows by planning kind before rendering. all=both SCHEDULED and DEADLINE items."
        },
        "org2.agenda.excludeKindFilter": {
          "type": "string",
          "enum": [
            "all",
            "scheduled",
            "deadline"
          ],
          "default": "all",
          "description": "Exclude agenda rows by planning kind before rendering. all=no exclusion, scheduled/deadline hide matching planning rows."
        },
        "org2.agenda.whenFilter": {
          "type": "string",
          "enum": [
            "all",
            "overdue",
            "today",
            "upcoming"
          ],
          "default": "all",
          "description": "Filter agenda rows by time bucket before rendering. all=overdue+today+upcoming, upcoming=rows after today in the current agenda window."
        },
        "org2.agenda.matchFilter": {
          "type": "string",
          "default": "",
          "description": "Filter agenda rows by headline text (case-insensitive). Supports comma-separated terms; a row matches when any term is present."
        },
        "org2.agenda.excludeMatchFilter": {
          "type": "string",
          "default": "",
          "description": "Exclude agenda rows by headline text (case-insensitive). Supports comma-separated terms; a row is hidden when any term is present."
        },
        "org2.agenda.tagFilter": {
          "type": "string",
          "default": "",
          "description": "Filter agenda rows by headline tags (case-insensitive exact tag match). Supports comma-separated tags; a row matches when any tag is present."
        },
        "org2.agenda.todoKeywordFilter": {
          "type": "string",
          "default": "",
          "description": "Filter agenda rows by exact TODO keyword (case-insensitive). Supports comma-separated keywords; a row matches when any keyword is present."
        },
        "org2.agenda.priorityFilter": {
          "type": "string",
          "default": "",
          "description": "Filter agenda rows by Org priority marker (for example `A,B` or `[#A],[#B]`, case-insensitive)."
        },
        "org2.agenda.excludeTagFilter": {
          "type": "string",
          "default": "",
          "description": "Exclude agenda rows by headline tags (case-insensitive exact tag match). Supports comma-separated tags; a row is hidden when any tag matches."
        },
        "org2.agenda.excludeTodoKeywordFilter": {
          "type": "string",
          "default": "",
          "description": "Exclude agenda rows by exact TODO keyword (case-insensitive). Supports comma-separated keywords; a row is hidden when any keyword matches."
        },
        "org2.agenda.excludePriorityFilter": {
          "type": "string",
          "default": "",
          "description": "Exclude agenda rows by Org priority marker (for example `A,B` or `[#A],[#B]`, case-insensitive)."
        },
        "org2.agenda.fileFilter": {
          "type": "string",
          "default": "",
          "description": "Filter agenda rows by source file path (case-insensitive substring match). Supports comma-separated terms; a row matches when its file path contains any term."
        },
        "org2.agenda.excludeFileFilter": {
          "type": "string",
          "default": "",
          "description": "Exclude agenda rows by source file path (case-insensitive substring match). Supports comma-separated terms; a row is hidden when its file path contains any term."
        },
        "org2.agenda.sortBy": {
          "type": "string",
          "default": "default",
          "description": "Sort agenda rows within each date by one or more keys (`file`, `headline`, `todo`, `kind`, `line`). Supports comma-separated values; use `default` for existing ordering."
        },
        "org2.formatter.fileFilter": {
          "type": "string",
          "default": "",
          "description": "Limit workspace formatter check/apply commands to files whose paths contain any comma-separated term (case-insensitive substring match)."
        },
        "org2.formatter.excludeFileFilter": {
          "type": "string",
          "default": "",
          "description": "Exclude files from workspace formatter check/apply commands when paths contain any comma-separated term (case-insensitive substring match)."
        },
        "org2.formatter.configFile": {
          "type": "string",
          "default": "",
          "description": "Optional org2.json path for workspace formatter commands. When set, workspace check/apply uses `org2 fmt --config <path>` instead of scanning `org2.agenda.dir` recursively."
        },
        "org2.capture.defaultFile": {
          "type": "string",
          "default": "",
          "description": "Optional default target file for `Org2: Capture Quick Entry`. Absolute paths are used directly; relative paths are resolved against org2.agenda.dir (or workspace root)."
        },
        "org2.capture.defaultTemplate": {
          "type": "string",
          "enum": ["note", "task"],
          "default": "note",
          "description": "Default template ordering for `Org2: Capture Quick Entry` (`note` or `task`)."
        },
        "org2.capture.defaultTodoKeyword": {
          "type": "string",
          "default": "TODO",
          "description": "Default TODO keyword ordering for task captures in `Org2: Capture Quick Entry` (`TODO`, `IN_PROGRESS`, `DONE`, `CANCELED`, or `CANCELLED`)."
        },
        "org2.capture.useSelectionAsBody": {
          "type": "boolean",
          "default": true,
          "description": "When enabled, `Org2: Capture Quick Entry` passes the current editor selection as capture body text (`--body`)."
        },
        "org2.export.outputDir": {
          "type": "string",
          "default": "_site",
          "description": "Output directory for `Org2: Export Workspace Org Files to HTML`. Absolute paths are used directly; relative paths are resolved against org2.agenda.dir (or workspace root)."
        },
        "org2.export.indexFile": {
          "type": "string",
          "default": "index.html",
          "description": "Optional index file path for workspace HTML export (`--index`). Empty disables index generation. Relative paths are resolved inside org2.export.outputDir."
        },
        "org2.export.indexTitle": {
          "type": "string",
          "default": "Org2 Export Index",
          "description": "Title used for the generated workspace export index page (`--index-title`). Ignored when org2.export.indexFile is empty."
        },
        "org2.export.stylesheets": {
          "type": "string",
          "default": "",
          "description": "Optional comma/newline-separated stylesheet URLs or paths passed as repeated `--css` flags to HTML export commands."
        },
        "org2.export.includeDefaultStyle": {
          "type": "boolean",
          "default": true,
          "description": "When enabled, HTML export includes Org2's built-in inline stylesheet. Disable to use external CSS only (`--no-default-style`)."
        },
        "org2.export.includeToc": {
          "type": "boolean",
          "default": false,
          "description": "When enabled, HTML export includes a generated table of contents with heading anchors (`--toc`)."
        },
        "org2.export.tocDepth": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "description": "Optional TOC heading depth limit for HTML export. Values >0 pass `--toc-depth N` (and implicitly enable TOC); 0 keeps full-depth TOC behavior."
        },
        "org2.export.numberHeadings": {
          "type": "boolean",
          "default": false,
          "description": "When enabled, HTML export prefixes headings (and TOC entries when present) with generated section numbers (`--number-headings`)."
        },
        "org2.export.numberHeadingsDepth": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "description": "Optional heading-number depth limit for HTML export. Values >0 pass `--number-headings-depth N` (and implicitly enable heading numbers); 0 keeps full-depth numbering behavior."
        },
        "org2.export.rewriteFileLinks": {
          "type": "boolean",
          "default": false,
          "description": "When enabled, HTML export rewrites Org file links to `.html` targets for published output and emits heading anchor IDs (including `:CUSTOM_ID:` targets) for rewritten `::* Heading` / `::#custom-id` links (`--rewrite-file-links`)."
        },
        "org2.formatOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Auto-format Org tables on save (runs `org2 fmt --stdin` and replaces the document)."
        },
        "org2.todo.writeTransitionLogbook": {
          "type": "boolean",
          "default": false,
          "description": "When enabled, TODO status updates from VS Code pass `--logbook` to org2 so state transitions are recorded in a LOGBOOK drawer."
        },
        "org2.editor.restoreSelectionAfterCliApply": {
          "type": "boolean",
          "default": true,
          "description": "Restore the previous selection after TODO/planning/archive commands apply and refresh the file from disk. Disable this if your setup still auto-expands folds around the cursor."
        },
        "org2.editor.refreshAfterCliApply": {
          "type": "boolean",
          "default": true,
          "description": "Force a post-apply disk refresh (`revertResource`) after TODO/planning/archive commands. TODO/planning only refresh when CLI output reports an actual change. Disable to rely on VS Code file watching and avoid refresh-related fold churn entirely."
        },
        "org2.editor.skipRefreshWhenInSync": {
          "type": "boolean",
          "default": true,
          "description": "When refresh-after-apply is enabled, skip explicit refresh if the open editor already matches on-disk content after CLI apply (reduces unnecessary fold churn)."
        },
        "org2.editor.allowGlobalRefreshFallback": {
          "type": "boolean",
          "default": false,
          "description": "Allow fallback to global `workbench.action.files.revert` when target-file `revertResource` is unavailable. Keep disabled to avoid global refresh side-effects (including fold churn in other editors)."
        },
        "org2.editor.navigationReveal": {
          "type": "string",
          "enum": ["default", "center", "outside", "none"],
          "default": "outside",
          "description": "Reveal behavior after Org2 non-agenda navigation commands (backlinks/open-file/open-id): outside is default and only recenters when target is offscreen, default uses normal VS Code reveal, center always recenters, none avoids forced reveal to reduce fold auto-expansion."
        },
        "org2.editor.navigationRevealFromAgenda": {
          "type": "string",
          "enum": ["default", "center", "outside", "none"],
          "default": "none",
          "description": "Reveal behavior specifically when opening items from the agenda. Default none avoids forced reveal calls (helps preserve folded context); default inherits org2.editor.navigationReveal, while outside/center force agenda-specific recentering."
        },
        "org2.folding.autoFoldMaxHeadingLevel": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "description": "Auto-fold headings at this exact level (1 = fold top-level sections, 2 = fold level-2 sections, 0 = disable auto-folding headings)."
        },
        "org2.folding.autoFoldPropertyDrawers": {
          "type": "boolean",
          "default": true,
          "description": "Auto-fold :PROPERTIES: drawers when a document is opened (once per file)."
        },
        "org2.keymap.power": {
          "type": "boolean",
          "default": true,
          "description": "Enable Org2 power keymap chords (macOS: cmd+; then key, Linux/Windows: ctrl+; then key) for Org/Org2 editors."
        },
        "org2.vim.visibleLineNavigation": {
          "type": "boolean",
          "default": false,
          "description": "When VSCodeVim is active in Normal mode, remap j/k in Org/Org2 editors to VS Code cursorDown/cursorUp so folded sections navigate by visible lines."
        }
      }
    },
