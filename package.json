{
  "name": "@aviaviavi/org2",
  "version": "0.1.2",
  "private": false,
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "org2": "dist/cli.js",
    "org2-lsp": "dist/lsp.js"
  },
  "files": [
    "dist",
    "README.org",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "parse": "node dist/parse.js",
    "print": "node dist/print.js",
    "org2": "node dist/cli.js",
    "lsp": "node dist/lsp.js",
    "fixtures": "node tools/fixture-runner.mjs",
    "cli-test": "node tools/cli-test-runner.mjs",
    "conformance-report": "node tools/conformance-report.mjs",
    "pretest": "npm run build",
    "prepublishOnly": "npm run build && npm test",
    "test": "npm run fixtures && npm run cli-test && node test-cli-agenda-tui.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@scarf/scarf": "^1.4.0"
  },
  "scarfSettings": {
    "allowTopLevel": true
  }
}
